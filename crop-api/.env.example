# ---------------------------------------------------------------------------
# AgriConnect crop-monitoring service (FastAPI) — environment
#
# Copy to `.env` and edit. Nothing here is secret by default: the service runs
# with GEE_ENABLED=false and no API key, which is fine for local development.
# ---------------------------------------------------------------------------

# --- Google Earth Engine ---------------------------------------------------
# false  -> deterministic synthetic series (no Google account, no network).
# true   -> real Sentinel-2 processing; requires earthengine-api + credentials.
GEE_ENABLED=false

# The Earth Engine Cloud project ID (used only when GEE_ENABLED=true).
GEE_PROJECT=agriconnect-crop-monitoring

# How long a computed series is cached, in seconds. Imagery changes about every
# 5 days, so 6 hours (21600) is plenty.
CACHE_TTL_SECONDS=21600

# --- Access control --------------------------------------------------------
# Leave empty for local development (the service logs a warning and allows all
# callers). Set a long random value before exposing the port; callers then send
# it as the `X-API-Key` header.
CROP_API_KEY=

# --- HTTP ------------------------------------------------------------------
# Comma-separated list of allowed browser origins, or `*` for any.
CORS_ORIGINS=*
