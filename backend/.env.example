# =============================================================================
# AgriConnect backend — environment example
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public base URL used in recovery links / OpenAPI servers
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated allowed CORS origins (mobile app uses no browser origin)
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL --------------------------------------------------------------
PGHOST=aws-0-eu-west-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.cukcjdwmrzzidyyrvlez
PGPASSWORD=replace-with-database-password
PGSSLMODE=require

# --- Auth / JWT --------------------------------------------------------------
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-DIFFERENT-64-char-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=15
VERIFICATION_CODE_TTL_MINUTES=10

# --- Account lifecycle -------------------------------------------------------
# Grace period (days) before personal data is anonymised after a deletion request
ACCOUNT_DELETION_GRACE_DAYS=14
# Retention (months) for de-identified financial/order records (legal/tax)
FINANCIAL_RETENTION_MONTHS=84

# --- Message delivery (password recovery / verification) ---------------------
# NONE | OUTBOX | SMTP | TWILIO
# With NONE/OUTBOX no external provider is used and messages are written to the
# `message_outbox` table only. THIS IS DEVELOPMENT-ONLY — see docs/07.
DELIVERY_PROVIDER=NONE
# In non-production, return the dev code in API responses so recovery is testable.
# MUST be false in production.
EXPOSE_DEV_CODES=true

# SMTP (if DELIVERY_PROVIDER=SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AgriConnect <no-reply@agriconnect.bw>"

# Twilio (if DELIVERY_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Google Earth Engine / Sentinel-2 ----------------------------------------
# Path to a GEE service-account JSON key (never commit the key itself)
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY=
GEE_PROJECT_ID=
# When unset/false the backend uses a deterministic mock NDVI generator so the
# pipeline, caching and UI are fully testable without external credentials.
GEE_ENABLED=false
NDVI_CLOUD_COVER_FAIL_THRESHOLD=80

# --- Satellite monitoring (crop-api processor) --------------------------------
# The optional FastAPI service in crop-api/ does the Sentinel-2 cloud/cloud-shadow
# masking and the NDVI + EVI reduction. When it is not configured the Node API
# generates a deterministic, clearly-labelled MOCK series (source "MOCK",
# isSimulated true) so the whole pipeline can be exercised offline. A mock series
# is never presented as a real observation.
CROP_API_ENABLED=false
CROP_API_URL=
# Shared secret the crop-api expects in the X-API-Key header. Server-side only:
# never ship it in the Android app.
CROP_API_KEY=
CROP_API_TIMEOUT_MS=30000

# Observation window and analysis thresholds. Documented in
# docs/12-SATELLITE-MONITORING.md and returned by the API so a client can show
# exactly which numbers raised an alert.
SATELLITE_DEFAULT_DAYS=120
SATELLITE_MAX_DAYS=365
SATELLITE_REFRESH_HOURS=6
SATELLITE_DROP_ABSOLUTE=0.15
SATELLITE_DROP_RELATIVE=0.15
SATELLITE_STALE_DAYS=10
SATELLITE_STRESS_NDVI=0.3
SATELLITE_NO_RECOVERY_DAYS=21
SATELLITE_DRY_RAIN_14D_MM=10
SATELLITE_HEAT_TEMP_MAX_C=32

# --- Weather (Open-Meteo, no API key) -----------------------------------------
# Modelled daily weather for a plot centroid. Free and keyless. Set
# WEATHER_ENABLED=false to disable it; the API then reports weather as
# unavailable rather than inventing readings.
WEATHER_ENABLED=true
WEATHER_BASE_URL=https://api.open-meteo.com
WEATHER_TIMEOUT_MS=8000
WEATHER_CACHE_TTL_SECONDS=1800

# --- App update manifest ------------------------------------------------------
# Served (publicly, no auth) at GET /api/v1/app/version. The default manifest is
# backend/version-manifest.json and MUST be edited on every release: uploading an
# APK does not update it. See docs/13-ANDROID-RELEASES.md.
APP_UPDATES_ENABLED=true
APP_VERSION_MANIFEST=
APK_DOWNLOAD_URL=
APK_PACKAGE_NAME=bw.agriconnect
APP_RELEASE_NOTES_URL=

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=2097152

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_SYNC_MAX=120
RATE_LIMIT_PUBLIC_MAX=300

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
