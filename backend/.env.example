# =============================================================================
# AgriConnect backend — environment example
# Copy to `.env` and fill in. NEVER commit the real `.env`.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public base URL used in recovery links / OpenAPI servers
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated allowed CORS origins (mobile app uses no browser origin)
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL --------------------------------------------------------------

NODE_ENV=development
PGHOST=db.cukcjdwmrzzidyyrvlez.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=@CSEagricconnect2026
PGSSLMODE=require

# --- Auth / JWT --------------------------------------------------------------
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-a-DIFFERENT-64-char-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=15
VERIFICATION_CODE_TTL_MINUTES=10

# --- Account lifecycle -------------------------------------------------------
# Grace period (days) before personal data is anonymised after a deletion request
ACCOUNT_DELETION_GRACE_DAYS=14
# Retention (months) for de-identified financial/order records (legal/tax)
FINANCIAL_RETENTION_MONTHS=84

# --- Message delivery (password recovery / verification) ---------------------
# NONE | OUTBOX | SMTP | TWILIO
# With NONE/OUTBOX no external provider is used and messages are written to the
# `message_outbox` table only. THIS IS DEVELOPMENT-ONLY — see docs/07.
DELIVERY_PROVIDER=NONE
# In non-production, return the dev code in API responses so recovery is testable.
# MUST be false in production.
EXPOSE_DEV_CODES=true

# SMTP (if DELIVERY_PROVIDER=SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AgriConnect <no-reply@agriconnect.bw>"

# Twilio (if DELIVERY_PROVIDER=TWILIO)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Google Earth Engine / Sentinel-2 ----------------------------------------
# Path to a GEE service-account JSON key (never commit the key itself)
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_PRIVATE_KEY=
GEE_PROJECT_ID=
# When unset/false the backend uses a deterministic mock NDVI generator so the
# pipeline, caching and UI are fully testable without external credentials.
GEE_ENABLED=false
NDVI_CLOUD_COVER_FAIL_THRESHOLD=80

# --- Uploads -----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=2097152

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MINUTES=15
RATE_LIMIT_SYNC_MAX=120
RATE_LIMIT_PUBLIC_MAX=300

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
